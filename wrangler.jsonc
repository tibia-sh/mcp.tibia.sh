{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-tibia-sh",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DEPLOY_COMMIT": "local"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "containers": [
    {
      "class_name": "TibiaWikiMcp",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP",
        "class_name": "TibiaWikiMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TibiaWikiMcp"]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "mcp.tibia.sh",
      "custom_domain": true
    }
  ]
}
